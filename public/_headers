# Ensure JS/CSS are served with correct MIME types.
# Fixes "Expected a JavaScript module script but the server responded with a MIME type of 'text/html'"
# on some hosts (e.g. Cloudflare Pages) that otherwise return HTML for asset requests.

/*.js
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/*.mjs
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/assets/*.js
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/assets/*.mjs
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/*.css
  Content-Type: text/css
  X-Content-Type-Options: nosniff

/assets/*.css
  Content-Type: text/css
  X-Content-Type-Options: nosniff
