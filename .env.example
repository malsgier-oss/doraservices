# Frontend (Cloudflare Pages -> Build-time environment variables)
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_DORA_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_DORA_SUPABASE_ANON_KEY="<your-supabase-anon-key>"

# Observability (optional)
# Sentry
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.05"

# Analytics (optional)
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"

# Optional / legacy (not required by the app after Phase 1)
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
